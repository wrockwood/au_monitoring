# Copy to .env, edit locally, and chmod 600 .env. Do not source this file.
# Use single quotes for literal values; double quotes support JSON escapes.
# No variable expansion, shell commands, export prefix, or inline comments.
LOCKSS_SSH_HOST=root@lockss.example.org
LOCKSS_UI_USERNAME=example-user
LOCKSS_UI_PASSWORD='replace-with-your-config-service-password'
LOCKSS_REMOTE_PORT=24621
LOCKSS_HTTP_TIMEOUT=120
LOCKSS_REPORTS_DIR=reports
